{
  "name": "@webblackbox/extension",
  "version": "0.7.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:store-safe": "wxt build --mode store-safe",
    "zip": "wxt zip",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run zip",
    "e2e:check": "node scripts/e2e-extension-check.mjs",
    "e2e:fullchain": "node scripts/e2e-fullchain-demo.mjs",
    "e2e:fullchain:lite": "WB_E2E_MODE=lite node scripts/e2e-fullchain-demo.mjs",
    "e2e:fullchain:lite:reload": "WB_E2E_MODE=lite WB_E2E_RELOAD_AFTER_START=1 node scripts/e2e-fullchain-demo.mjs",
    "e2e:fullchain:full": "WB_E2E_MODE=full node scripts/e2e-fullchain-demo.mjs",
    "e2e:fullchain:full:defaults": "WB_E2E_MODE=full WB_E2E_CONFIGURE_OPTIONS=0 node scripts/e2e-fullchain-demo.mjs",
    "e2e:fullchain:lite:on-demand": "WB_E2E_MODE=lite WB_E2E_RELOAD_AFTER_START=1 WB_E2E_INJECTION_MODE=on-start node scripts/e2e-fullchain-demo.mjs",
    "e2e:fullchain:full:on-demand": "WB_E2E_MODE=full WB_E2E_INJECTION_MODE=on-start node scripts/e2e-fullchain-demo.mjs",
    "e2e:injection": "node scripts/e2e-injection-modes.mjs",
    "e2e:injection:idle": "WB_E2E_INJECTION_BENCH=1 node scripts/e2e-injection-modes.mjs",
    "e2e:page-globals": "node scripts/e2e-page-globals.mjs",
    "e2e:full:reload": "node scripts/e2e-full-start-reload.mjs",
    "e2e:completeness:full": "WB_E2E_MODE=full WB_E2E_COMPLETENESS=1 node scripts/e2e-fullchain-demo.mjs",
    "e2e:completeness:full:heavy": "WB_E2E_MODE=full WB_E2E_COMPLETENESS=1 WB_E2E_HEAVY_BURST=1 node scripts/e2e-fullchain-demo.mjs",
    "e2e:completeness:full:reload": "WB_E2E_MODE=full WB_E2E_COMPLETENESS=1 WB_E2E_RELOAD_AFTER_START=1 node scripts/e2e-fullchain-demo.mjs",
    "e2e:sw-restart": "node scripts/e2e-sw-restart.mjs",
    "e2e:profile:rules": "node scripts/e2e-profile-rules.mjs",
    "e2e:pointer": "node scripts/e2e-pointer-capture.mjs",
    "e2e:profile:maximum": "node scripts/e2e-profile-maximum.mjs",
    "e2e:settings-migration": "node scripts/e2e-settings-migration.mjs",
    "e2e:capture-fallback": "node scripts/e2e-capture-fallback.mjs",
    "e2e:kept-after-stop": "node scripts/e2e-kept-after-stop.mjs",
    "e2e:tabs-context": "node scripts/e2e-tabs-context.mjs",
    "e2e:ui": "node scripts/e2e-ui-screenshots.mjs",
    "e2e:ui:update": "WB_UI_SHOTS_UPDATE=1 node scripts/e2e-ui-screenshots.mjs",
    "e2e:at-rest": "node scripts/e2e-at-rest-encryption.mjs",
    "e2e:realworld": "node scripts/e2e-realworld-stability.mjs",
    "e2e:realworld:quick": "WB_E2E_REALWORLD_QUICK=1 node scripts/e2e-realworld-stability.mjs",
    "e2e:realworld:ci": "node scripts/e2e-realworld-stability.mjs",
    "e2e:isolation:full": "node scripts/e2e-cdp-tab-isolation.mjs",
    "e2e:memory:full": "node scripts/e2e-full-memory-regression.mjs",
    "e2e:memory:full:ci": "WB_E2E_STRESS_REQUESTS=96 WB_E2E_STRESS_CONCURRENCY=4 WB_E2E_MEMORY_SAMPLE_MS=1500 WB_E2E_MEMORY_SETTLE_SAMPLES=1 WB_E2E_MEMORY_TIMEOUT_MS=90000 node scripts/e2e-full-memory-regression.mjs",
    "e2e:perf:lite": "node scripts/e2e-lite-perf-regression.mjs",
    "e2e:perf:lite:ci": "WB_E2E_PERF_REQUESTS=32 WB_E2E_PERF_WARMUP_REQUESTS=12 WB_E2E_PERF_INTERACTION_ROUNDS=8 WB_E2E_PERF_IFRAME_ROUNDS=6 WB_E2E_PERF_EDITOR_ROUNDS=12 WB_E2E_PERF_NAV_ROUNDS=6 WB_E2E_PERF_NAV_WAIT_MS=6000 node scripts/e2e-lite-perf-regression.mjs",
    "lint": "eslint src scripts entrypoints wxt.config.ts --ext .ts",
    "typecheck": "node scripts/generate-locales.mjs && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@webblackbox/cdp-router": "workspace:*",
    "@webblackbox/pipeline": "workspace:*",
    "@webblackbox/protocol": "workspace:*",
    "@webblackbox/recorder": "workspace:*",
    "@zumer/snapdom": "^2.24.18",
    "webblackbox": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "vite": "8.3.3",
    "wxt": "0.21.4"
  }
}
