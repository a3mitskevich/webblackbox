{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../config/typescript/node-app.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@webblackbox/cdp-router": ["../../packages/cdp-router/src/index.ts"],
      "@webblackbox/pipeline": ["../../packages/pipeline/src/index.ts"],
      "@webblackbox/pipeline/storage": ["../../packages/pipeline/src/storage-entry.ts"],
      "@webblackbox/protocol": ["../../packages/protocol/src/index.ts"],
      "@webblackbox/protocol/*": ["../../packages/protocol/src/*.ts"],
      "@webblackbox/recorder": ["../../packages/recorder/src/index.ts"],
      "webblackbox": ["../../packages/webblackbox/src/index.ts"],
      "webblackbox/capture-scope": ["../../packages/webblackbox/src/capture-scope.ts"],
      "webblackbox/injected-hooks": ["../../packages/webblackbox/src/injected-hooks.ts"],
      "webblackbox/input-value-policy": ["../../packages/webblackbox/src/input-value-policy.ts"],
      "webblackbox/lite-capture-agent": ["../../packages/webblackbox/src/lite-capture-agent.ts"],
      "webblackbox/lite-materializer": ["../../packages/webblackbox/src/lite-materializer.ts"],
      "webblackbox/lite-sdk": ["../../packages/webblackbox/src/lite-sdk.ts"],
      "webblackbox/types": ["../../packages/webblackbox/src/types.ts"],
      "@zumer/snapdom": ["./node_modules/@zumer/snapdom/types/snapdom.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "tsup.config.ts", "scripts/**/*.mjs"]
}
