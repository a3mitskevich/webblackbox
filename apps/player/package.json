{
  "name": "@webblackbox/player",
  "version": "0.6.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "bench": "tsx scripts/benchmark.ts",
    "build": "vite build",
    "e2e:player": "pnpm run build && node scripts/e2e-player.mjs",
    "pages:build": "pnpm build && node scripts/prepare-pages-build.mjs",
    "pages:deploy": "node scripts/deploy-gh-pages.mjs",
    "serve": "vite preview --strictPort",
    "lint": "eslint src scripts --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@leeoniya/ufuzzy": "1.0.19",
    "@tanstack/react-virtual": "3.14.13",
    "@webblackbox/player-sdk": "workspace:*",
    "@webblackbox/protocol": "workspace:*",
    "diff": "9.0.0",
    "lucide-react": "1.52.0",
    "microdiff": "1.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "6.1.6",
    "react-hotkeys-hook": "5.3.3",
    "react-resizable-panels": "4.14.2",
    "shiki": "4.5.0",
    "uplot": "1.6.32",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@webblackbox/pipeline": "workspace:*",
    "axe-core": "4.14.0",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.2",
    "vite": "8.3.3"
  }
}
