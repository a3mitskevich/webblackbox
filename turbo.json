{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".output/**"]
    },
    // `wxt zip` rebuilds into the same .output/chrome-mv3/ (WXT empties it) as `build`: never run
    // the two at once.
    "zip": {
      "dependsOn": ["^build", "build"],
      "outputs": [".output/**"]
    },
    // The player build ships the packaged extension (build/extension/): package it first.
    "@webblackbox/player#build": {
      "dependsOn": ["^build", "@webblackbox/extension#zip"],
      "outputs": ["build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/config/workspace-sources.mjs"],
      "outputs": []
    }
  }
}
