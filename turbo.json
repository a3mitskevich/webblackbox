{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    // Packaging rebuilds into the same build/ (tsup --clean) as `build`: never run the two at once.
    "package:chrome": {
      "dependsOn": ["^build", "build"],
      "outputs": ["build/**", "dist/**"]
    },
    // The player build ships the packaged extension (build/extension/): package it first.
    "@webblackbox/player#build": {
      "dependsOn": ["^build", "@webblackbox/extension#package:chrome"],
      // The usage videos (git-ignored recorder output) are bundled too: a new take must rebuild.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/extension/demo-video-output/*.mp4"],
      "env": ["WB_PLAYER_VIDEOS_DIR"],
      "outputs": ["build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/config/workspace-sources.mjs"],
      "outputs": []
    }
  }
}
