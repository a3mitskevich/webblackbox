{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "package:chrome": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"]
    },
    // The player build ships the packaged extension (build/extension/): package it first.
    "@webblackbox/player#build": {
      "dependsOn": ["^build", "@webblackbox/extension#package:chrome"],
      "outputs": ["build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/config/workspace-sources.mjs"],
      "outputs": []
    }
  }
}
